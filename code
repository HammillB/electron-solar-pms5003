// Reference for the sensor protocol can be found here:
// https://cdn-shop.adafruit.com/product-files/3686/plantower-pms5003-manual_v2-3.pdf

// Define the pin for the status LED. It's HIGH when the device is awake.
const int PIN_STATUS_LED = D6;

// Define the number of minutes the device will sleep between readings.
const int SLEEP_DURATION_MINUTES = 19;

// Sensor communication commands
const uint8_t CMD_WAKE[] = { 0x42, 0x4D, 0xE4, 0x00, 0x01, 0x01, 0x74 };
const uint8_t CMD_SLEEP[] = { 0x42, 0x4D, 0xE4, 0x00, 0x00, 0x01, 0x73 };

// Sensor data frame structure constants
const uint8_t FRAME_HEADER_1 = 0x42;
const uint8_t FRAME_HEADER_2 = 0x4D;
const int PM25_HIGH_BYTE_INDEX = 6;
const int PM25_LOW_BYTE_INDEX = 7;
const int MAX_FRAME_LENGTH = 32; // PMS5003 data frame is 32 bytes long

// A FuelGauge object for monitoring the battery state.
FuelGauge fuel;

// Forward declaration for our new sensor reading function
int readPmSensor();

void setup() {
    // Start the hardware serial port for the sensor.
    Serial1.begin(9600);

    // Set up the status LED pin.
    pinMode(PIN_STATUS_LED, OUTPUT);
}

void loop() {
    // Turn on the status LED to indicate the device is awake.
    digitalWrite(PIN_STATUS_LED, HIGH);

    // Read the PM2.5 value from the sensor.
    int pm25 = readPmSensor();

    // If the reading is valid (non-negative), publish the data.
    if (pm25 >= 0) {
        float batterySoC = fuel.getSoC();
        Particle.publish("pm25", String(pm25), PRIVATE);
        Particle.publish("batterySoC", String::format("%.2f", batterySoC), PRIVATE);
    }

    // Put the sensor to sleep.
    Serial1.write(CMD_SLEEP, sizeof(CMD_SLEEP));
    delay(1000); // Give the sensor time to process the command.

    // Turn off the status LED.
    digitalWrite(PIN_STATUS_LED, LOW);

    // Put the Particle device to sleep to conserve battery.
    // It will wake up on a rising edge on D0 or after the timeout.
    System.sleep(D0, RISING, SLEEP_DURATION_MINUTES * 60, SLEEP_NETWORK_STANDBY);
}

/**
 * @brief Wakes the PM sensor, reads a data frame, and extracts the PM2.5 value.
 * @return The PM2.5 reading, or -1 if an error occurred.
 */
int readPmSensor() {
    // Wake the sensor up.
    Serial1.write(CMD_WAKE, sizeof(CMD_WAKE));
    delay(15000); // Wait for the sensor to warm up and stabilize.

    // Read the data frame from the serial port.
    int index = 0;
    char frameBuffer[MAX_FRAME_LENGTH];

    // We need to find the start of the frame.
    // Read bytes until we see the first header byte or timeout.
    unsigned long startTime = millis();
    while (Serial1.peek() != FRAME_HEADER_1) {
        Serial1.read(); // Discard byte
        if (millis() - startTime > 2000) { // 2-second timeout
            return -1; // Error: Timed out waiting for header
        }
    }

    // Now, try to read the full frame.
    if (Serial1.available() >= MAX_FRAME_LENGTH) {
        Serial1.readBytes(frameBuffer, MAX_FRAME_LENGTH);

        // Verify the frame header.
        if (frameBuffer[0] == FRAME_HEADER_1 && frameBuffer[1] == FRAME_HEADER_2) {
            // The PM2.5 value is a 16-bit integer (big-endian).
            int pm25 = (frameBuffer[PM25_HIGH_BYTE_INDEX] << 8) | frameBuffer[PM25_LOW_BYTE_INDEX];
            return pm25;
        }
    }

    // Clear the serial buffer of any remaining data to prevent issues on the next read.
    while (Serial1.available()) {
        Serial1.read();
    }
    
    return -1; // Error: Frame not found or incomplete
}
